# Copy to .env and fill in. Do NOT commit .env.

# SQL Server SA password (8+ chars, must include upper, lower, digit, symbol).
MSSQL_SA_PASSWORD=Change_me_strong_123!

# From your Entra app registration (run register-app.ps1 or see README).
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000

# First user to sign in with this email becomes Admin.
ADMIN_EMAIL=you@yourdomain.com

# Must match a SPA redirect URI on the app registration.
# For local Docker, http://localhost:8080 works (Entra allows http://localhost).
REDIRECT_URI=http://localhost:8080
