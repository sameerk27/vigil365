<Window x:Class="M365SecurityDashboard.GuiInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vigil365 Setup Wizard" Height="640" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="#2563EB" Grid.Column="0">
            <StackPanel Margin="20">
                <TextBlock Text="Vigil365 Setup" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,30" />
                
                <TextBlock x:Name="Step1Label" Text="1. Prerequisites" FontSize="16" Foreground="White" FontWeight="Bold" Margin="0,10" />
                <TextBlock x:Name="Step2Label" Text="2. Configuration" FontSize="16" Foreground="#80FFFFFF" Margin="0,10" />
                <TextBlock x:Name="Step3Label" Text="3. Installation" FontSize="16" Foreground="#80FFFFFF" Margin="0,10" />
                <TextBlock x:Name="Step4Label" Text="4. Complete" FontSize="16" Foreground="#80FFFFFF" Margin="0,10" />
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="30">
            
            <!-- Step 1: Prerequisites -->
            <StackPanel x:Name="PanelPrerequisites" Visibility="Visible">
                <TextBlock Text="Checking Prerequisites" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" />
                
                <TextBlock Text="This installer requires .NET 8, Node.js, and Azure CLI." TextWrapping="Wrap" Margin="0,0,0,20" />
                
                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <TextBlock x:Name="DotnetStatus" Text="⌛ .NET 8 SDK" Width="200" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <TextBlock x:Name="NodeStatus" Text="⌛ Node.js" Width="200" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <TextBlock x:Name="AzStatus" Text="⌛ Azure CLI" Width="200" />
                </StackPanel>

                <Button x:Name="BtnCheckPrereqs" Content="Check Now" Width="120" Height="35" HorizontalAlignment="Left" Margin="0,30,0,0" Click="BtnCheckPrereqs_Click" />
                <Button x:Name="BtnNextToConfig" Content="Next: Configuration" Width="150" Height="35" HorizontalAlignment="Right" Margin="0,-35,0,0" Visibility="Collapsed" Click="BtnNextToConfig_Click" />
            </StackPanel>

            <!-- Step 2: Configuration -->
            <ScrollViewer x:Name="PanelConfig" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Application Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" />

                <TextBlock Text="Address people will use (e.g. https://vigil365.mycompany.com)" FontWeight="SemiBold" Margin="0,10,0,5" />
                <TextBox x:Name="TxtUrl" Height="30" Padding="5" Text="https://" TextChanged="TxtUrl_TextChanged" />
                <TextBlock x:Name="UrlHint" Text="" TextWrapping="Wrap" FontSize="11" Foreground="#B45309" Margin="0,4,0,0" />

                <TextBlock Text="First Administrator Email" FontWeight="SemiBold" Margin="0,15,0,5" />
                <TextBox x:Name="TxtAdminEmail" Height="30" Padding="5" />

                <!-- HTTPS. Sign-in goes through Entra, which refuses plain HTTP for
                     anything but localhost, so a certificate is not optional here.
                     Default is the option that needs no decision. -->
                <TextBlock Text="HTTPS Certificate" FontSize="18" FontWeight="SemiBold" Margin="0,25,0,4" />
                <TextBlock Text="Vigil365 must be served over HTTPS — Microsoft sign-in will not work otherwise."
                           TextWrapping="Wrap" FontSize="12" Foreground="#475569" Margin="0,0,0,10" />

                <RadioButton x:Name="RadCertStore" GroupName="Cert" Content="Use a certificate already installed on this server" Margin="0,4"
                             Checked="CertOption_Changed" />
                <ComboBox x:Name="CmbCertStore" Height="28" Margin="22,4,0,6" IsEnabled="False" DisplayMemberPath="Display" />

                <RadioButton x:Name="RadCertPfx" GroupName="Cert" Content="Use a certificate file (.pfx)" Margin="0,4"
                             Checked="CertOption_Changed" />
                <Grid Margin="22,4,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtPfxPath" Grid.Column="0" Height="28" Padding="5" IsEnabled="False" />
                    <Button x:Name="BtnBrowsePfx" Grid.Column="1" Content="Browse..." Width="80" Height="28" Margin="6,0" IsEnabled="False" Click="BtnBrowsePfx_Click" />
                    <PasswordBox x:Name="TxtPfxPassword" Grid.Column="2" Height="28" Padding="5" IsEnabled="False" />
                </Grid>

                <RadioButton x:Name="RadCertSelfSigned" GroupName="Cert" Content="Create one for me (recommended to get started)" IsChecked="True" Margin="0,4"
                             Checked="CertOption_Changed" />
                <TextBlock Text="Vigil365 generates a certificate and trusts it on this server. Browsers on other machines will warn until you replace it with one from your own CA."
                           TextWrapping="Wrap" FontSize="11" Foreground="#B45309" Margin="22,2,0,0" />

                <TextBlock Text="Database Settings" FontSize="18" FontWeight="SemiBold" Margin="0,25,0,10" />
                <CheckBox x:Name="ChkInstallSql" Content="Download and install SQL Server Express locally (Recommended)" IsChecked="True" Checked="ChkInstallSql_Checked" Unchecked="ChkInstallSql_Unchecked" />

                <StackPanel x:Name="PanelSqlString" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="Existing SQL Connection String" FontWeight="SemiBold" Margin="0,5,0,5" />
                    <TextBox x:Name="TxtSqlString" Height="30" Padding="5" Text="Server=.\SQLEXPRESS;Database=Vigil365;Trusted_Connection=True;TrustServerCertificate=True" />
                </StackPanel>

                <Button x:Name="BtnStartInstall" Content="Begin Installation" Width="150" Height="35" HorizontalAlignment="Right" Margin="0,30,0,10" Click="BtnStartInstall_Click" />
              </StackPanel>
            </ScrollViewer>

            <!-- Step 3: Installation -->
            <StackPanel x:Name="PanelInstall" Visibility="Collapsed">
                <TextBlock Text="Installing Vigil365..." FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" />
                
                <ProgressBar x:Name="InstallProgress" Height="20" Minimum="0" Maximum="100" Margin="0,0,0,20" />
                <TextBlock x:Name="InstallStatusText" Text="Starting..." Margin="0,0,0,10" />
                
                <TextBox x:Name="TxtLog" Height="250" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Background="#F1F5F9" Padding="10" />
                
                <Button x:Name="BtnNextToDone" Content="Next" Width="100" Height="35" HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="Collapsed" Click="BtnNextToDone_Click" />
            </StackPanel>

            <!-- Step 4: Done -->
            <StackPanel x:Name="PanelDone" Visibility="Collapsed">
                <TextBlock Text="Installation Complete!" FontSize="26" Foreground="#10B981" FontWeight="Bold" Margin="0,0,0,20" />
                
                <TextBlock Text="Vigil365 has been successfully installed and the Windows Service is running." TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10" />
                <TextBlock Text="The Microsoft Entra App Registration was also provisioned automatically." TextWrapping="Wrap" FontSize="14" Margin="0,0,0,30" />
                
                <TextBlock x:Name="TxtDoneAddress" Text="" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Border x:Name="PanelCertWarning" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" Padding="12" Margin="0,0,0,20" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="About the certificate" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock x:Name="TxtCertWarning" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </Border>

                <Button x:Name="BtnOpenApp" Content="Open Vigil365" Width="200" Height="50" FontSize="16" Background="#2563EB" Foreground="White" HorizontalAlignment="Left" Click="BtnOpenApp_Click" />
            </StackPanel>

        </Grid>
    </Grid>
</Window>
