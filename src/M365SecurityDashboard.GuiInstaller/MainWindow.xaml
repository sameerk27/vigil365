<Window x:Class="M365SecurityDashboard.GuiInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vigil365 Setup Wizard" Height="640" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="#2563EB" Grid.Column="0">
            <StackPanel Margin="20">
                <TextBlock Text="Vigil365 Setup" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,30" />
                
                <TextBlock x:Name="Step1Label" Text="1. Prerequisites" FontSize="16" Foreground="White" FontWeight="Bold" Margin="0,10" />
                <TextBlock x:Name="Step2Label" Text="2. Configuration" FontSize="16" Foreground="#80FFFFFF" Margin="0,10" />
                <TextBlock x:Name="Step3Label" Text="3. Installation" FontSize="16" Foreground="#80FFFFFF" Margin="0,10" />
                <TextBlock x:Name="Step4Label" Text="4. Complete" FontSize="16" Foreground="#80FFFFFF" Margin="0,10" />
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="30">
            
            <!-- Step 1: Prerequisites -->
            <StackPanel x:Name="PanelPrerequisites" Visibility="Visible">
                <TextBlock Text="Checking Prerequisites" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" />
                
                <TextBlock Text="Vigil365 and everything it runs on are contained in this installer. Only one external tool is needed, and it is installed automatically if missing."
                           TextWrapping="Wrap" Margin="0,0,0,20" />

                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <TextBlock x:Name="AdminStatus" Text="⌛ Administrator rights" Width="240" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <TextBlock x:Name="AzStatus" Text="⌛ Azure CLI" Width="240" />
                </StackPanel>
                <TextBlock Text="Azure CLI is used only to register Vigil365 with Microsoft Entra so people can sign in."
                           TextWrapping="Wrap" FontSize="11" Foreground="#475569" Margin="0,0,0,10" />

                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <TextBlock x:Name="PayloadStatus" Text="⌛ Application package" Width="240" />
                </StackPanel>

                <Button x:Name="BtnCheckPrereqs" Content="Check Now" Width="120" Height="35" HorizontalAlignment="Left" Margin="0,30,0,0" Click="BtnCheckPrereqs_Click" />
                <Button x:Name="BtnNextToConfig" Content="Next: Configuration" Width="150" Height="35" HorizontalAlignment="Right" Margin="0,-35,0,0" Visibility="Collapsed" Click="BtnNextToConfig_Click" />
            </StackPanel>

            <!-- Step 2: Configuration -->
            <ScrollViewer x:Name="PanelConfig" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Application Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />

                <!-- Everything below keys off this. Evaluating on one box needs no
                     hostname, no certificate and no firewall hole, so asking for
                     them is pure friction. -->
                <TextBlock Text="Who needs to reach Vigil365?" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

                <RadioButton x:Name="RadScopeLocal" GroupName="Scope" IsChecked="True" Margin="0,4" Checked="Scope_Changed">
                    <StackPanel>
                        <TextBlock Text="Just this computer" FontWeight="SemiBold" />
                        <TextBlock Text="For trying Vigil365 out. No certificate or firewall changes needed." FontSize="11" Foreground="#475569" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="RadScopeNetwork" GroupName="Scope" Margin="0,8" Checked="Scope_Changed">
                    <StackPanel>
                        <TextBlock Text="Other people on our network" FontWeight="SemiBold" />
                        <TextBlock Text="Needs a hostname and an HTTPS certificate." FontSize="11" Foreground="#475569" />
                    </StackPanel>
                </RadioButton>

                <Border x:Name="PanelLocalSummary" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" Padding="10" Margin="0,12,0,0">
                    <TextBlock x:Name="TxtLocalSummary" Text="Vigil365 will be available at http://localhost:8080 on this computer."
                               TextWrapping="Wrap" FontSize="12" />
                </Border>

                <StackPanel x:Name="PanelNetworkSettings" Visibility="Collapsed">
                    <TextBlock Text="Address people will use (e.g. https://vigil365.mycompany.com)" FontWeight="SemiBold" Margin="0,16,0,5" />
                    <TextBox x:Name="TxtUrl" Height="30" Padding="5" Text="https://" TextChanged="TxtUrl_TextChanged" />
                    <TextBlock x:Name="UrlHint" Text="" TextWrapping="Wrap" FontSize="11" Foreground="#B45309" Margin="0,4,0,0" />

                    <!-- Entra refuses plain HTTP redirect URIs for anything but
                         localhost, so once this is reachable by hostname a
                         certificate stops being optional. -->
                    <TextBlock Text="HTTPS Certificate" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,4" />
                    <TextBlock Text="Microsoft sign-in will not work without HTTPS on a named host."
                               TextWrapping="Wrap" FontSize="12" Foreground="#475569" Margin="0,0,0,10" />

                    <RadioButton x:Name="RadCertStore" GroupName="Cert" Content="Use a certificate already installed on this server" Margin="0,4"
                                 Checked="CertOption_Changed" />
                    <ComboBox x:Name="CmbCertStore" Height="28" Margin="22,4,0,6" IsEnabled="False" DisplayMemberPath="Display" />

                    <RadioButton x:Name="RadCertPfx" GroupName="Cert" Content="Use a certificate file (.pfx)" Margin="0,4"
                                 Checked="CertOption_Changed" />
                    <Grid Margin="22,4,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPfxPath" Grid.Column="0" Height="28" Padding="5" IsEnabled="False" />
                        <Button x:Name="BtnBrowsePfx" Grid.Column="1" Content="Browse..." Width="80" Height="28" Margin="6,0" IsEnabled="False" Click="BtnBrowsePfx_Click" />
                        <PasswordBox x:Name="TxtPfxPassword" Grid.Column="2" Height="28" Padding="5" IsEnabled="False" />
                    </Grid>

                    <RadioButton x:Name="RadCertSelfSigned" GroupName="Cert" Content="Create one for me (quickest)" IsChecked="True" Margin="0,4"
                                 Checked="CertOption_Changed" />
                    <TextBlock Text="Browsers on other machines will warn until you replace it with one from your own CA."
                               TextWrapping="Wrap" FontSize="11" Foreground="#B45309" Margin="22,2,0,0" />
                </StackPanel>

                <TextBlock Text="Who is the first administrator?" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,4" />
                <TextBlock x:Name="TxtAdminEmailHint" Text="Taken from your Azure sign-in. Change it if someone else should be the first admin."
                           TextWrapping="Wrap" FontSize="11" Foreground="#475569" Margin="0,0,0,5" />
                <TextBox x:Name="TxtAdminEmail" Height="30" Padding="5" />

                <TextBlock Text="Database" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,6" />
                <TextBlock x:Name="TxtSqlDetected" Text="" TextWrapping="Wrap" FontSize="11" Foreground="#475569" Margin="0,0,0,6" />
                <CheckBox x:Name="ChkInstallSql" Content="Install SQL Server Express locally" IsChecked="True" Checked="ChkInstallSql_Checked" Unchecked="ChkInstallSql_Unchecked" />

                <StackPanel x:Name="PanelSqlString" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="Existing SQL Connection String" FontWeight="SemiBold" Margin="0,5,0,5" />
                    <TextBox x:Name="TxtSqlString" Height="30" Padding="5" Text="Server=.\SQLEXPRESS;Database=Vigil365;Trusted_Connection=True;TrustServerCertificate=True" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,10">
                    <Button x:Name="BtnBackToPrereqs" Content="Back" Width="90" Height="35" Margin="0,0,8,0" Click="BtnBackToPrereqs_Click" />
                    <Button x:Name="BtnStartInstall" Content="Begin Installation" Width="150" Height="35" Click="BtnStartInstall_Click" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <!-- Step 3: Installation -->
            <StackPanel x:Name="PanelInstall" Visibility="Collapsed">
                <TextBlock x:Name="InstallHeading" Text="Installing Vigil365..." FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" />

                <ProgressBar x:Name="InstallProgress" Height="20" Minimum="0" Maximum="100" Margin="0,0,0,20" />
                <TextBlock x:Name="InstallStatusText" Text="Starting..." Margin="0,0,0,10" />

                <!-- Shown only on failure. An installer that stops with a raw
                     exception and no way back leaves the user with nothing to do
                     but close it and guess. -->
                <Border x:Name="PanelFailure" Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TxtFailureTitle" Text="" FontWeight="Bold" FontSize="14" Foreground="#991B1B" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock Text="What to do" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtFailureRemedy" Text="" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnBackToConfig" Content="Back to Configuration" Width="170" Height="32" Click="BtnBackToConfig_Click" />
                            <Button x:Name="BtnCopyLog" Content="Copy details" Width="110" Height="32" Margin="8,0,0,0" Click="BtnCopyLog_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBox x:Name="TxtLog" Height="200" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Background="#F1F5F9" Padding="10" />

                <Button x:Name="BtnNextToDone" Content="Next" Width="100" Height="35" HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="Collapsed" Click="BtnNextToDone_Click" />
            </StackPanel>

            <!-- Step 4: Done -->
            <StackPanel x:Name="PanelDone" Visibility="Collapsed">
                <TextBlock Text="Installation Complete!" FontSize="26" Foreground="#10B981" FontWeight="Bold" Margin="0,0,0,20" />
                
                <TextBlock Text="Vigil365 has been successfully installed and the Windows Service is running." TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10" />
                <TextBlock Text="The Microsoft Entra App Registration was also provisioned automatically." TextWrapping="Wrap" FontSize="14" Margin="0,0,0,30" />
                
                <TextBlock x:Name="TxtDoneAddress" Text="" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Border x:Name="PanelCertWarning" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" Padding="12" Margin="0,0,0,20" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="About the certificate" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock x:Name="TxtCertWarning" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </Border>

                <Button x:Name="BtnOpenApp" Content="Open Vigil365" Width="200" Height="50" FontSize="16" Background="#2563EB" Foreground="White" HorizontalAlignment="Left" Click="BtnOpenApp_Click" />
            </StackPanel>

        </Grid>
    </Grid>
</Window>
